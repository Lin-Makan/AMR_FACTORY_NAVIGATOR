<?xml version="1.0"?>

<robot name="amr_robot">

    <link name="base_link">

        <visual>
            <geometry>
                <box size="0.5 0.5 0.2"/>
            </geometry>
        </visual>

        <collision>
            <geometry>
                <box size="0.5 0.5 0.2"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="10.0"/>

            <origin xyz="0 0 0"/>

            <inertia
                ixx="1.0"
                ixy="0.0"
                ixz="0.0"
                iyy="1.0"
                iyz="0.0"
                izz="1.0"/>
        </inertial>

    </link>

</robot>