<?xml version="1.0"?>

<robot name="amr_robot">

  <!-- ========================= -->
  <!-- BASE -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <material name="chassis_blue">
        <color rgba="0.06 0.22 0.62 1.0"/>
      </material>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.78 0.58 0.22"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.70 0.55 0.22"/>
      </geometry>
    </collision>


    <!-- ========================= -->
    <!-- VEHICLE BODY DETAILS -->
    <!-- ========================= -->

    <!-- Upper equipment deck -->
    <visual>
      <material name="upper_deck">
        <color rgba="0.10 0.12 0.15 1.0"/>
      </material>
      <origin xyz="0 0 0.27"/>
      <geometry>
        <box size="0.62 0.48 0.10"/>
      </geometry>
    </visual>

    <!-- Front bumper -->
    <visual>
      <material name="bumper_dark">
        <color rgba="0.025 0.03 0.035 1.0"/>
      </material>
      <origin xyz="0.405 0 0.075"/>
      <geometry>
        <box size="0.055 0.54 0.11"/>
      </geometry>
    </visual>

    <!-- Rear bumper -->
    <visual>
      <material name="bumper_dark">
        <color rgba="0.025 0.03 0.035 1.0"/>
      </material>
      <origin xyz="-0.405 0 0.075"/>
      <geometry>
        <box size="0.055 0.54 0.11"/>
      </geometry>
    </visual>

    <!-- Left side protection panel -->
    <visual>
      <material name="side_panel">
        <color rgba="0.035 0.045 0.06 1.0"/>
      </material>
      <origin xyz="0 0.285 0.15"/>
      <geometry>
        <box size="0.68 0.035 0.14"/>
      </geometry>
    </visual>

    <!-- Right side protection panel -->
    <visual>
      <material name="side_panel">
        <color rgba="0.035 0.045 0.06 1.0"/>
      </material>
      <origin xyz="0 -0.285 0.15"/>
      <geometry>
        <box size="0.68 0.035 0.14"/>
      </geometry>
    </visual>

    <!-- LiDAR mast -->
    <visual>
      <material name="mast_dark">
        <color rgba="0.06 0.065 0.07 1.0"/>
      </material>
      <origin xyz="0 0 0.345"/>
      <geometry>
        <cylinder radius="0.035" length="0.14"/>
      </geometry>
    </visual>

    <!-- Front identification panel -->
    <visual>
      <material name="front_panel">
        <color rgba="0.02 0.025 0.03 1.0"/>
      </material>
      <origin xyz="0.395 0 0.17"/>
      <geometry>
        <box size="0.025 0.40 0.075"/>
      </geometry>
    </visual>

    <inertial>
      <origin xyz="0 0 0.11"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.288"
        ixy="0.0"
        ixz="0.0"
        iyy="0.449"
        iyz="0.0"
        izz="0.688"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- LEFT WHEEL -->
  <!-- ========================= -->

  <link name="left_wheel">

    <visual>
      <material name="wheel_black">
        <color rgba="0.03 0.03 0.03 1.0"/>
      </material>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- RIGHT WHEEL -->
  <!-- ========================= -->

  <link name="right_wheel">

    <visual>
      <material name="wheel_black">
        <color rgba="0.03 0.03 0.03 1.0"/>
      </material>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- LEFT WHEEL JOINT -->
  <!-- ========================= -->

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.32 0.12"
            rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>


  <!-- ========================= -->
  <!-- RIGHT WHEEL JOINT -->
  <!-- ========================= -->

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.32 0.12"
            rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>


  <ros2_control name="AMRSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/user/ros2_ws/install/amr_bringup/share/amr_bringup/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

    <!-- ========================= -->
  <!-- LIDAR -->
  <!-- ========================= -->

  <link name="lidar_link">
    <visual>
      <material name="lidar_black">
        <color rgba="0.04 0.04 0.04 1.0"/>
      </material>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.055"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>

      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>

      <update_rate>10</update_rate>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>

      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
